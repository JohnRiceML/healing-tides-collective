{
  "name": "healing-tides-collective",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:db": "node scripts/test-with-db.mjs npm run test:e2e",
    "test:integration:db": "node scripts/test-with-db.mjs npm run test:integration",
    "sanity:extract": "sanity schema extract",
    "sanity:typegen": "sanity schema extract && sanity typegen generate",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:migrate:safe": "node scripts/db-safe-migrate.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:backup": "node scripts/db-backup.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.2",
    "@next/third-parties": "^16.2.4",
    "@portabletext/react": "^6.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.24.0",
    "@vercel/blob": "^2.4.0",
    "ai": "^6.0.195",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "next": "^16.0.0",
    "next-sanity": "^12.4.5",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^5.24.0",
    "styled-components": "^6.4.1",
    "svix": "^1.95.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
