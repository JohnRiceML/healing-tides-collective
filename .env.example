# Healing Tides Collective — required environment variables (NO secrets in this file).
# Local dev: pull the real values from Vercel with `vercel env pull .env.local`.

# --- Sanity (editorial CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# --- Database: Neon Postgres (via the Vercel Neon integration; Custom Prefix left empty) ---
DATABASE_URL=            # pooled endpoint — runtime
DATABASE_URL_UNPOOLED=   # direct endpoint — Prisma directUrl (migrations)

# --- Admin access ---
# Comma-separated emails that get /admin access without a DB role write. Match the
# email the user signs in with via Clerk. e.g. nora@healingtides.co, you@example.com
ADMIN_EMAILS=

# --- Phase 2 services (not wired yet — see docs/architecture/PHASE-2-SYSTEMS.md) ---
# Clerk:  NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, CLERK_WEBHOOK_SIGNING_SECRET,
#         NEXT_PUBLIC_CLERK_SIGN_IN_URL, NEXT_PUBLIC_CLERK_SIGN_UP_URL
# Stripe: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID
# Resend: RESEND_API_KEY, EMAIL_FROM
