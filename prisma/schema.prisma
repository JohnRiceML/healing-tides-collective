// Healing Tides Collective — data model. Postgres (Neon), Prisma 7 (`prisma-client` generator).
//
// Design (see docs/architecture/PHASE-2-SYSTEMS.md):
// - Identity is owned by Clerk. `User` is a LOCAL MIRROR keyed by clerkUserId,
//   synced via a Clerk webhook (auth-clerk). Billing state (Stripe) is mirrored
//   on the row (billing-stripe) so access gating is a single row read.
// - This DB is DEDICATED to Healing Tides — never shared with another product.
// - Practitioner Listing MVP (docs/briefs/practitioner-listing-mvp.md): the
//   Practitioner profile is PII, NOT client PHI — which is why it ships first.
//   Seeker / Match models still await the matching brief.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 no longer accepts connection URLs here — they live in prisma.config.ts.
// Runtime connection is supplied by the pg adapter in lib/db.ts (pooled DATABASE_URL);
// the CLI (migrations) uses the direct DATABASE_URL_UNPOOLED via prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  SEEKER
  PRACTITIONER
  ADMIN
}

// Mirrors Stripe subscription state. NONE = never subscribed.
enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique @map("clerk_user_id")
  email       String?
  role        Role    @default(SEEKER)

  // Stripe billing mirror (source of truth = Stripe; written by the Stripe webhook).
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  subscriptionStatus   SubscriptionStatus @default(NONE) @map("subscription_status")
  currentPeriodEnd     DateTime?          @map("current_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Last time this user was signed in & active (touched, throttled, on auth resolve).
  // Powers the admin "who's active" read. Nullable: backfills naturally as people return.
  lastSeenAt DateTime? @map("last_seen_at")

  practitioner Practitioner?

  @@map("users")
}

// ── Practitioner Listing MVP ────────────────────────────────────────────────
// Profile data is PII, NOT client PHI (see the brief). Standard PII handling only.

enum ProfileVisibility {
  DRAFT
  PUBLISHED
  HIDDEN
  NEEDS_REVIEW
}

enum Modality {
  IN_PERSON
  HYBRID
  VIRTUAL
}

// Dormant in V1 — INDIVIDUAL only. The others let one umbrella account hold
// multiple sub-listings later (group practice / treatment center).
enum AccountType {
  INDIVIDUAL
  GROUP_PRACTICE
  TREATMENT_CENTER
}

model Practitioner {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public profile — mostly nullable so sign-up creates a DRAFT shell.
  slug        String? @unique
  displayName String? @map("display_name")
  photoUrl    String? @map("photo_url") // Vercel Blob
  bio         String?
  website     String?
  socialLinks Json?   @map("social_links")

  // Match-critical, STRUCTURED — the future matcher consumes these (no re-intake).
  specialties       String[]  @default([]) // taxonomy IDs; the taxonomy itself is admin-owned config
  modality          Modality?
  region            String?
  insuranceAccepted String[]  @default([]) @map("insurance_accepted")
  gender            String? // practitioner gender — used as a client preference filter in matching
  values            String? // "what healing means to me" — the differentiator; powers values matching

  // Answers to Nora's config-driven extra fields (the field schema is admin-owned config).
  fieldValues Json? @map("field_values")

  // State + instrumentation.
  visibility   ProfileVisibility @default(DRAFT)
  completeness Int               @default(0) // 0–100, recomputed on edit; drives nudges
  viewCount    Int               @default(0) @map("view_count") // denormalized; ProfileView is source of truth

  // Dormant hooks — unused/unenforced in V1; present so tiers/groups are cheap to switch on.
  accountType AccountType @default(INDIVIDUAL) @map("account_type")
  tier        String? // null = free (V1: everyone)
  featured    Boolean     @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  views   ProfileView[]
  matches Match[]

  @@index([visibility])
  @@map("practitioners")
}

// One profile view — minimal, no PII. The count becomes upsell evidence later.
model ProfileView {
  id             String       @id @default(cuid())
  practitionerId String       @map("practitioner_id")
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  viewedAt       DateTime     @default(now()) @map("viewed_at")

  @@index([practitionerId])
  @@index([viewedAt])
  @@map("profile_views")
}

// A pre-seeded invitation for a waitlist practitioner to "claim" their profile.
// We deliberately DON'T pre-create Practitioner rows (those require a User, and would
// pollute the directory) — the invite holds the prefill until someone signs up and
// claims it via /claim/[token]. `token` is the opaque, unguessable URL segment.
model Invite {
  id              String    @id @default(cuid())
  token           String    @unique
  email           String // who it's for (from Nora's waitlist)
  displayName     String?   @map("display_name") // prefill
  prefill         Json      @default("{}") // {region, specialties, title, website, …} from the CSV
  createdAt       DateTime  @default(now()) @map("created_at")
  claimedAt       DateTime? @map("claimed_at")
  claimedByUserId String?   @map("claimed_by_user_id") // the User.id that claimed it

  @@index([email])
  @@map("invites")
}

enum FeedbackKind {
  BUG
  IDEA
  PRAISE
  OTHER
}

enum FeedbackStatus {
  NEW
  TRIAGED
  PLANNED
  FIXED
  WONT_FIX
}

// Site-wide feedback from anyone (seekers + practitioners). Intentionally lightweight +
// mostly anonymous — only what the person volunteers (message + optional email) plus the page
// and an optional signed-in user id for context. The admin triages it through to FIXED — the
// fix-loop that records what we ship in response.
model Feedback {
  id         String         @id @default(cuid())
  message    String
  kind       FeedbackKind   @default(OTHER)
  email      String? // optional — only if they want a reply
  path       String? // the page it came from
  userId     String?        @map("user_id") // signed-in user, if any (informational; no FK so anon stays simple)
  role       String? // who sent it — ANONYMOUS / SEEKER / PRACTITIONER / ADMIN (resolved server-side)
  screenshotUrl String?     @map("screenshot_url") // optional attached screenshot (Vercel Blob)
  status     FeedbackStatus @default(NEW)
  adminNote  String?        @map("admin_note") // the triage / fix note
  createdAt  DateTime       @default(now()) @map("created_at")
  resolvedAt DateTime?      @map("resolved_at")

  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

// ── Milestone 2: the seeker loop ─────────────────────────────────────────────
// The app supports Nora's judgment, it doesn't replace it: matching STAYS HUMAN (see the
// Phase-2 scope). A seeker submits an intake; Nora reads the free-text story and hand-picks a
// shortlist (Match rows); the shortlist is emailed back (Phase 3).
//
// HIPAA posture (compliant-by-design; final sign-off is John/Christie's): MINIMAL PII — just a
// name + email to send the shortlist. Preferences only. Insurance is a BOOLEAN, never a plan or
// member id. No seeker account required. The free-text `story` is the sensitive field (it may
// carry health context) — it lives only in our DB (Neon, encrypted at rest) and is never shown
// to a practitioner until Nora chooses to.

enum SeekerIntakeStatus {
  NEW
  REVIEWING
  MATCHED
  CLOSED
}

model SeekerIntake {
  id String @id @default(cuid())

  // Minimal contact — needed only to send the curated shortlist back.
  name  String
  email String

  // The heart of it — what Nora reads, in the seeker's own words.
  story String

  // Structured preferences — all optional ("none of this is binding"); they narrow candidates.
  lookingFor       String[] @default([]) // high-level care types (Therapy, Reiki, …)
  specialties      String[] @default([]) // taxonomy category ids (areas of focus) → practitioner.specialties
  region           String?
  format           String? // in-person / virtual / either (modality preference)
  ageGroup         String?  @map("age_group") // who the care is for
  genderPreference String?  @map("gender_preference")
  usesInsurance    Boolean? @map("uses_insurance") // boolean only — never a plan / member id
  budgetNote       String?  @map("budget_note") // their own words, optional
  availability     String?
  urgency          String?

  // Config-driven extras — Nora's final questions slot in here, migration-free (mirrors Practitioner.fieldValues).
  fieldValues Json? @map("field_values")

  // Signed-in user id, if any (most seekers are anonymous — informational, no FK).
  userId String? @map("user_id")

  status    SeekerIntakeStatus @default(NEW)
  adminNote String?            @map("admin_note") // Nora's internal note
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  matches Match[]

  @@index([status])
  @@index([createdAt])
  @@map("seeker_intakes")
}

enum MatchStatus {
  SUGGESTED // on Nora's shortlist, not yet sent
  SENT // included in the shortlist emailed to the seeker
  DECLINED // Nora removed it
}

// One practitioner Nora hand-picked for a seeker's intake (a shortlist is several of these).
// The de-identified practitioner ping + the seeker email land in Phase 3.
model Match {
  id             String       @id @default(cuid())
  seekerIntakeId String       @map("seeker_intake_id")
  seekerIntake   SeekerIntake @relation(fields: [seekerIntakeId], references: [id], onDelete: Cascade)
  practitionerId String       @map("practitioner_id")
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  status MatchStatus @default(SUGGESTED)
  reason String? // Nora's "why I thought of them" sentence

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([seekerIntakeId, practitionerId]) // a practitioner appears once per intake
  @@index([seekerIntakeId])
  @@map("matches")
}
